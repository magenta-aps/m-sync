MSYNC__DIRECTORY_SERVICE=microsoft_cloud

# these settings are required if you need to sync with Microsoft Exchange Online/
# Microsoft 365/Microsoft Entra/Azure/whatever else Microsoft runs in the cloud
MSYNC__MICROSOFT_CLOUD__TENANT_ID=1234abcd
MSYNC__MICROSOFT_CLOUD__CLIENT_ID=1234abcd
MSYNC__MICROSOFT_CLOUD__CLIENT_SECRET=hunter2
MSYNC__MICROSOFT_CLOUD__FULL_SYNC_PERIOD=25:00:00

# these settings are required if you need to sync with Nextcloud
# the values below match the nextcloud service in compose.test.yaml
MSYNC__NEXTCLOUD__URL=http://nextcloud
# the service user must be allowed to share with every account. Otherwise a
# ghost can get the address of an account it cannot see
MSYNC__NEXTCLOUD__SERVICE_USER=msync
MSYNC__NEXTCLOUD__SERVICE_PASSWORD=msync-service-password
MSYNC__NEXTCLOUD__MANAGER_USER=msync-manager
MSYNC__NEXTCLOUD__MANAGER_PASSWORD=msync-manager-password
MSYNC__NEXTCLOUD__ALLOW_HTTP=true

# only the Nextcloud integration tests use these to log in as the Nextcloud admin
# the values match the nextcloud service in compose.test.yaml
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=msync-admin-password

# the name of the Nextcloud container, only for the integration test that runs
# occ with docker exec to turn off allow_user_to_change_email
#NEXTCLOUD_CONTAINER=msync-nextcloud-1
